classDiagram
    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
    }

    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : schedules
    Scheduler --> Owner : reads all tasks

